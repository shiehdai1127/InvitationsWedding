    <!-- JavaScript Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if ('scrollRestoration' in history) {
                history.scrollRestoration = 'manual';
            }
            window.scrollTo(0, 0);
            document.body.classList.add('gate-locked');

            const btnOpenGate = document.getElementById('btn-open-gate');
            const gateSec = document.getElementById('sec-00');
            const gateContent = document.getElementById('gate-content');
            const gateCenterDecoration = document.getElementById('gate-center-decoration');
            const heroSec = document.getElementById('sec-01');

            const bgMusic = document.getElementById('bg-music');
            const btnAudioToggle = document.getElementById('btn-audio-toggle');
            const audioIcon = document.getElementById('audio-icon');
            let isPlaying = false;

            // 宮門開啟事件觸發
            if (btnOpenGate) {
                btnOpenGate.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.scrollTo(0, 0);

                    if (gateSec) gateSec.classList.add('doors-open');
                    if (gateContent) gateContent.style.opacity = '0';
                    if (gateCenterDecoration) gateCenterDecoration.style.opacity = '0';

                    document.body.classList.remove('gate-locked');

                    if (heroSec) heroSec.classList.add('is-revealed');

                    if (bgMusic && !isPlaying) {
                        bgMusic.play().then(() => {
                            if (audioIcon) audioIcon.className = 'fa-solid fa-music text-sm md:text-base animate-spin-slow text-zhusanzhi';
                            isPlaying = true;
                        }).catch(err => console.log('Audio playback blocked:', err));
                    }

                    setTimeout(function() {
                        if (gateSec) {
                            gateSec.style.opacity = '0';
                            gateSec.style.pointerEvents = 'none';
                            setTimeout(() => {
                                gateSec.style.display = 'none';
                            }, 1000);
                        }
                    }, 2200);
                });
            }

            // 音樂播放按鈕
            if (btnAudioToggle && bgMusic) {
                btnAudioToggle.addEventListener('click', function() {
                    if (isPlaying) {
                        bgMusic.pause();
                        audioIcon.className = 'fa-solid fa-music text-sm md:text-base opacity-40';
                        isPlaying = false;
                    } else {
                        bgMusic.play().then(() => {
                            audioIcon.className = 'fa-solid fa-music text-sm md:text-base animate-spin-slow text-zhusanzhi';
                            isPlaying = true;
                        }).catch(e => console.log('Audio autoplay blocked'));
                    }
                });
            }

            // 畫卷電腦端箭頭滾動
            const scrollTrack = document.getElementById('scroll-track');
            const scrollPrevBtn = document.getElementById('scroll-prev-btn');
            const scrollNextBtn = document.getElementById('scroll-next-btn');

            if (scrollTrack && scrollPrevBtn && scrollNextBtn) {
                scrollPrevBtn.addEventListener('click', () => {
                    scrollTrack.scrollBy({ left: -scrollTrack.clientWidth * 0.7, behavior: 'smooth' });
                });
                scrollNextBtn.addEventListener('click', () => {
                    scrollTrack.scrollBy({ left: scrollTrack.clientWidth * 0.7, behavior: 'smooth' });
                });
            }

            // 行事曆 Modal
            const btnAddCal = document.getElementById('btn-add-calendar');
            const calModal = document.getElementById('calendar-modal');
            const btnCloseModal = document.getElementById('btn-close-modal');
            const btnGoogleCal = document.getElementById('btn-google-cal');
            const btnIcalCal = document.getElementById('btn-ical-cal');

            if (btnAddCal && calModal) {
                btnAddCal.addEventListener('click', () => calModal.classList.remove('hidden'));
            }
            if (btnCloseModal && calModal) {
                btnCloseModal.addEventListener('click', () => calModal.classList.add('hidden'));
            }

            // Google Calendar
            if (btnGoogleCal) {
                btnGoogleCal.addEventListener('click', () => {
                    const gCalUrl = "https://calendar.google.com/calendar/render?action=TEMPLATE" +
                        "&text=" + encodeURIComponent("淵隆與岱融的婚禮") +
                        "&dates=20261219T030000Z/20261219T073000Z" +
                        "&details=" + encodeURIComponent("戶外證婚：11:00\n敬請入席：12:00\n午宴開席：12:30\n\n誠邀您一同見證我們的幸福時刻！") +
                        "&location=" + encodeURIComponent("芙莉嘉 Frigga Garden，新北市板橋區縣民大道二段275號3樓");
                    window.open(gCalUrl, '_blank');
                    calModal.classList.add('hidden');
                });
            }

            // Apple / iCal .ics File
            if (btnIcalCal) {
                btnIcalCal.addEventListener('click', () => {
                    const icsContent = 
                        "BEGIN:VCALENDAR\n" +
                        "VERSION:2.0\n" +
                        "PRODID:-//Wedding Invitation//CN\n" +
                        "BEGIN:VEVENT\n" +
                        "SUMMARY:淵隆與岱融的婚禮\n" +
                        "DESCRIPTION:戶外證婚：11:00\\n敬請入席：12:00\\n午宴開席：12:30\\n\\n誠邀您一同見證我們的幸福時刻！\n" +
                        "LOCATION:芙莉嘉 Frigga Garden，新北市板橋區縣民大道二段275號3樓\n" +
                        "DTSTART:20261219T030000Z\n" +
                        "DTEND:20261219T073000Z\n" +
                        "END:VEVENT\n" +
                        "END:VCALENDAR";

                    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
                    const link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.setAttribute('download', 'wedding-invitation.ics');
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    calModal.classList.add('hidden');
                });
            }

            // Intersection Observer
            const observerOptions = {
                root: null,
                rootMargin: '10px 0px 10px 0px',
                threshold: 0.12
            };

            const sectionObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-revealed');
                    } else {
                        entry.target.classList.remove('is-revealed');
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.reveal-sec').forEach(sec => {
                sectionObserver.observe(sec);
            });

            // 專屬印章蓋印 Observer (當賓客滾動到印章區域時精準播放落印動畫)
            const stampContainer = document.getElementById('stamp-container');
            if (stampContainer) {
                const stampObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            stampContainer.classList.add('is-stamping');
                        } else {
                            stampContainer.classList.remove('is-stamping');
                        }
                    });
                }, { threshold: 0.5 });
                stampObserver.observe(stampContainer);
            }

            // Accordion Logic
            const accordionBtns = document.querySelectorAll('.accordion-btn');
            accordionBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const content = this.nextElementSibling;
                    const icon = this.querySelector('.accordion-icon');
                    
                    if (content.classList.contains('hidden')) {
                        content.classList.remove('hidden');
                        if (icon) icon.textContent = '−';
                    } else {
                        content.classList.add('hidden');
                        if (icon) icon.textContent = '＋';
                    }
                });
            });

            // Countdown Timer
            const targetDate = new Date('2026-12-19T11:00:00+08:00').getTime();
            
            function updateCountdown() {
                const now = new Date().getTime();
                const diff = targetDate - now;

                const daysEl = document.getElementById('cd-days-v');
                const hoursEl = document.getElementById('cd-hours-v');
                const minsEl = document.getElementById('cd-mins-v');
                const secsEl = document.getElementById('cd-secs-v');
                const arrivedEl = document.getElementById('cd-arrived-v');
                const counterContainer = document.getElementById('vertical-countdown-container');

                if (diff <= 0) {
                    if (counterContainer) counterContainer.classList.add('hidden');
                    if (arrivedEl) arrivedEl.classList.remove('hidden');
                    return;
                }

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
                if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
                if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
                if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
            }

            setInterval(updateCountdown, 1000);
            updateCountdown();

            // Restart Button
            const btnRestart = document.getElementById('btn-restart');
            if (btnRestart) {
                btnRestart.addEventListener('click', function() {
                    window.scrollTo(0, 0);
                    document.body.classList.add('gate-locked');
                    
                    if (gateSec) {
                        gateSec.style.display = 'flex';
                        gateSec.style.pointerEvents = 'auto';
                        setTimeout(() => {
                            gateSec.style.opacity = '1';
                            gateSec.classList.remove('doors-open');
                            if (gateContent) gateContent.style.opacity = '1';
                            if (gateCenterDecoration) gateCenterDecoration.style.opacity = '1';
                        }, 100);
                    }

                    document.querySelectorAll('.reveal-sec').forEach(sec => {
                        sec.classList.remove('is-revealed');
                    });
                });
            }
        });
    </script>

<script id="living-invitation-interactions">
document.addEventListener('DOMContentLoaded',function(){
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
 const cue=document.getElementById('btn-read-on');
 if(cue)cue.addEventListener('click',function(){document.getElementById('sec-02').scrollIntoView({behavior:reduced.matches?'auto':'smooth',block:'start'});});
 const track=document.getElementById('scroll-track');
 const pages=Array.from(document.querySelectorAll('.gallery-page'));
 if(!track)return;
 const items=Array.from(track.children);
 pages.forEach(function(button,index){button.addEventListener('click',function(){
  const box=items[index].getBoundingClientRect(),frame=track.getBoundingClientRect();
  track.scrollBy({left:box.left-frame.left-(track.clientWidth-box.width)/2,behavior:reduced.matches?'auto':'smooth'});
 });});
 let queued=false;
 function update(){
  queued=false;const frame=track.getBoundingClientRect(),center=frame.left+track.clientWidth/2;
  let active=0,distance=Infinity;
  items.forEach(function(item,index){const box=item.getBoundingClientRect(),d=Math.abs(box.left+box.width/2-center);if(d<distance){distance=d;active=index;}});
  pages.forEach(function(button,index){button.setAttribute('aria-current',String(index===active));});
 }
 track.addEventListener('scroll',function(){if(!queued){queued=true;requestAnimationFrame(update);}},{passive:true});
 window.addEventListener('resize',function(){if(!queued){queued=true;requestAnimationFrame(update);}},{passive:true});
 track.querySelectorAll('img').forEach(function(img){img.addEventListener('load',update,{once:true});});update();
});
</script>
