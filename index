    <style>
      /* Custom Classical Scrollbar */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: rgb(243,237,225); }
      ::-webkit-scrollbar-thumb { background: rgb(202,177,132); border-radius: 3px; }
      
      html, body {
        width: 100%;
        margin: 0;
        padding: 0;
        font-family: 'Noto Serif TC', serif;
        background-color: rgb(250,247,238);
        color: rgb(69,53,43);
        overflow-x: hidden;
      }

      /* Slow spin animation for audio note (12s per loop) */
      @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .animate-spin-slow {
        animation: spinSlow 12s linear infinite;
      }

      /* Prevent auto scroll restoring on refresh */
      html {
        scroll-behavior: auto !important;
      }

      /* Lock body scroll while palace doors are closed */
      body.gate-locked {
        overflow: hidden !important;
        touch-action: none !important;
      }

      /* Paper texture is embedded in the manuscript stylesheet below. */

      /* Classical Seals (朱砂印章) */
      .seal-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgb(151,48,45);
        color: rgb(151,48,45);
        background-color: rgba(151, 48, 45, 0.05);
        border-radius: 4px;
        font-weight: bold;
        box-shadow: inset 0 0 4px rgba(151,48,45,0.2);
        user-select: none;
      }

      /* 3D Door Opening Animations */
      .perspective-1000 {
        perspective: 1400px;
      }
      
      .door-left {
        transform-origin: left center;
        transition: transform 2.2s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .door-right {
        transform-origin: right center;
        transition: transform 2.2s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .doors-open .door-left {
        transform: rotateY(-105deg);
      }
      .doors-open .door-right {
        transform: rotateY(105deg);
      }

      /* Wood Texture & Door Details */
      .gongmen-wood-left {
        background: linear-gradient(90deg, rgb(92,24,22) 0%, rgb(140,42,39) 25%, rgb(112,34,34) 50%, rgb(156,50,47) 75%, rgb(110,31,29) 100%);
        box-shadow: inset -10px 0 20px rgba(0,0,0,0.5);
      }
      .gongmen-wood-right {
        background: linear-gradient(90deg, rgb(110,31,29) 0%, rgb(156,50,47) 25%, rgb(112,34,34) 50%, rgb(140,42,39) 75%, rgb(92,24,22) 100%);
        box-shadow: inset 10px 0 20px rgba(0,0,0,0.5);
      }

      /* Classical Door Studs (門釘) */
      .door-stud {
        width: 14px;
        height: 14px;
        background: radial-gradient(circle at 30% 30%, rgb(247,224,170), rgb(202,158,88) 60%, rgb(90,66,27) 100%);
        border-radius: 50%;
        box-shadow: 2px 3px 5px rgba(0,0,0,0.6), inset 1px 1px 2px rgba(255,255,255,0.8);
      }

      /* Line Drawing SVG path */
      .draw-line {
        stroke-dasharray: 800;
        stroke-dashoffset: 800;
        transition: stroke-dashoffset 2s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .is-revealed .draw-line {
        stroke-dashoffset: 0;
      }

      /* Seal Stamping Animation */
      .animate-seal {
        opacity: 0;
        transform: scale(1.8) translateY(-15px) rotate(-8deg);
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }
      .is-revealed .animate-seal {
        opacity: 1;
        transform: scale(1) translateY(0) rotate(0deg);
      }

      /* -------------------------------------------------------------
         朱砂雙印・依序落印動畫 (STAMP DROP ANIMATION)
         ------------------------------------------------------------- */
      @keyframes stampDrop {
        0% {
          opacity: 0;
          transform: translateY(-16px) scale(1.18);
        }
        70% {
          opacity: 1;
          transform: translateY(0) scale(1.06);
        }
        100% {
          opacity: 1;
          transform: translateY(0) scale(1.0);
        }
      }

      .seal-stamp-item {
        opacity: 0;
        will-change: transform, opacity;
      }

      /* 當印章區域真正滑入視域 (.is-stamping) 時才觸發蓋印 */
      .is-stamping .seal-stamp-long {
        animation: stampDrop 0.55s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        animation-delay: 1.5s;
      }

      .is-stamping .seal-stamp-rong {
        animation: stampDrop 0.55s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        animation-delay: 2.4s;
      }

      /* Horizontal Scroll Opening Animation */
      .scroll-wrapper-anim {
        clip-path: inset(0 50% 0 50%);
        transition: clip-path 1.8s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .is-revealed .scroll-wrapper-anim {
        clip-path: inset(0 0% 0 0%);
      }

      /* Hide Scrollbar for Horizontal Scroll Track */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* HERO PHOTO ENTRANCE */
      .hero-photo-entrance {
        opacity: 0;
        filter: blur(10px);
        transform: scale(1.02);
        transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), 
                    filter 0.8s cubic-bezier(0.22, 1, 0.36, 1), 
                    transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: opacity, filter, transform;
      }
      .is-revealed .hero-photo-entrance {
        opacity: 1;
        filter: blur(0px);
        transform: scale(1);
      }

      /* PHOTO 2: Haitang Window Radial Mask Unveil */
      .radial-reveal-box {
        clip-path: circle(0% at 50% 50%);
        opacity: 0;
        transition: clip-path 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease-out;
        will-change: clip-path, opacity;
      }
      .is-revealed .radial-reveal-box {
        clip-path: circle(120% at 50% 50%);
        opacity: 1;
      }

      /* Staggered Text Items */
      .stagger-item {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.6s ease-out, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .is-revealed .stagger-item {
        opacity: 1;
        transform: translateY(0);
      }

      /* Swallow entrance */
      .swallow-in-left {
        opacity: 0;
        transform: translate(-30px, -20px);
        transition: opacity 1.2s ease, transform 1.2s ease;
      }
      .is-revealed .swallow-in-left {
        opacity: 1;
        transform: translate(0, 0);
      }
      .swallow-in-right {
        opacity: 0;
        transform: translate(30px, -20px);
        transition: opacity 1.2s ease, transform 1.2s ease;
      }
      .is-revealed .swallow-in-right {
        opacity: 1;
        transform: translate(0, 0);
      }

      /* Reduced motion fallback */
      @media (prefers-reduced-motion: reduce) {
        .hero-photo-entrance, .radial-reveal-box, .scroll-wrapper-anim, 
        .stagger-item, .swallow-in-left, .swallow-in-right, .animate-seal,
        .seal-stamp-item {
          opacity: 1 !important;
          filter: none !important;
          transform: none !important;
          clip-path: none !important;
          animation: none !important;
        }
      }
    </style>
